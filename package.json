{
  "name": "cult-of-threads",
  "private": true,
  "scripts": {
    "reset:npm": "bun rm:npm && bun install",
    "rm:npm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "dotenv -e .env -- turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "gen:supabase": "dotenv -e .env -- sh -c 'supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/supabase/src/database.types.ts'",
    "supabase:link": "dotenv -e .env -- sh -c 'supabase link --project-ref $SUPABASE_PROJECT_ID'",
    "supabase:pull": "dotenv -e .env -- sh -c 'supabase db pull'",
    "migration:generate": "dotenv -e .env -- bun --filter ./apps/api migration:generate",
    "migration:run": "dotenv -e .env -- bun --filter ./apps/api migration:run"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@platejs/basic-nodes": "^49.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^0.539.0",
    "mathjs": "^15.2.0",
    "motion": "^11.18.2",
    "ogl": "^1.0.11",
    "platejs": "^49.2.21",
    "posthog-js": "^1.367.0",
    "qs": "^6.15.3",
    "react-day-picker": "^9.14.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-sparkle": "^2.0.0",
    "react-spinners": "^0.17.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.35",
    "yet-another-react-lightbox": "^3.31.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/validator": "^13.15.10",
    "dotenv-cli": "^10.0.0",
    "globals": "^15.15.0",
    "supabase": "^2.100.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "vite": "^7.3.2"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=18"
  }
}
