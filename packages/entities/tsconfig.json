{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "module": "ESNext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "outDir": "dist",
        "rootDir": "src",
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}