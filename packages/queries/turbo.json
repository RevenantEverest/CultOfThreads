{
  "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["build:queries"],
            "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_KEY"]
        },
        "build:queries": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"],
            "env": [
                "API_*",
                "NEXT_PUBLIC_*"
            ]
        },
        "dev": {
            "with": ["dev:queries"],
            "env": [
                "API_*",
                "NEXT_PUBLIC_*"
            ]
        },
        "dev:queries": {
            "cache": false,
            "persistent": true
        }
    }
}