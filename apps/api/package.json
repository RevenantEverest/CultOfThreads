{
    "name": "api",
    "version": "0.1.0",
    "type": "module",
    "main": "src/server.ts",
    "private": true,
    "scripts": {
        "build:datasource": "swc src -d dist",
        "migration:generate": "bun run build:datasource && ../../node_modules/typeorm/cli.js migration:generate src/migrations/init --dataSource ./dist/src/db/dataSource.js",
        "migration:run": "bun run build:datasource && ../../node_modules/typeorm/cli.js migration:run --dataSource ./dist/src/db/dataSource.js",
        "dev": "bun --watch run ./src/server.ts",
        "start": "bun ./src/server.ts",
        "lint": ""
    },
    "dependencies": {
        "@repo/entities": "workspace:*",
        "chalk": "^5.6.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "jose": "^6.2.2",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.28",
        "typeorm-naming-strategies": "^4.1.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@swc/cli": "^0.7.10",
        "@swc/core": "^1.15.24",
        "@types/chalk": "^2.2.4",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.12.2"
    }
}